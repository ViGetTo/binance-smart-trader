# Только PAPER, DEMO, BACKTEST. Режима LIVE нет.
TRADER_MODE=PAPER
TRADER_CONFIG=config.toml
TRADER_DB=data/paper-lab.sqlite
TRADER_PAPER_LAB=true
PAPER_INITIAL_BALANCE=4900
# OFF: no account access, no signed Binance requests. Public prices have their own switch.
BINANCE_ENABLED=false
BINANCE_MARKET_DATA_ENABLED=true
TRADER_AUTO_UPDATE=true
TRADER_STRICT_DEMO=true
TRADER_DEMO_SYNC_BALANCE=true
TRADER_WEB_ENABLED=false
TRADER_STRATEGY_AUTO=true
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
# Опционально. Бот отправляет сообщения только при наличии обоих значений.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
